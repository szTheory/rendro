{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rubric_scores.schema.json",
  "title": "Rendro Rubric Scores Manifest",
  "description": "Structural contract for priv/quality/rubric_scores.json. Constrains structure and threshold arithmetic only (6 dimensions, 2 gates, hierarchy=5/core>=4) — never the subjective score values, which Phase 118 appends.",
  "type": "object",
  "required": ["schema_version", "dimensions", "gates", "thresholds", "scores", "stress_exemption", "catalog_dispositions"],
  "properties": {
    "schema_version": { "const": 1 },
    "dimensions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "label", "anchors"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "information_architecture",
              "content_hierarchy",
              "domain_fit",
              "reader_affordances",
              "typographic_craft",
              "restraint_cohesion"
            ]
          },
          "label": { "type": "string", "minLength": 1 },
          "anchors": {
            "type": "object",
            "required": ["1", "3", "4", "5"],
            "properties": {
              "1": { "type": "string", "minLength": 1 },
              "3": { "type": "string", "minLength": 1 },
              "4": { "type": "string", "minLength": 1 },
              "5": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "gates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "label", "description"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["reading_order", "print_safety"]
          },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "thresholds": {
      "type": "object",
      "required": ["hierarchy_dimension", "hierarchy_min", "core_min"],
      "properties": {
        "hierarchy_dimension": { "const": "content_hierarchy" },
        "hierarchy_min": { "const": 5 },
        "core_min": { "type": "integer", "minimum": 4, "maximum": 5 }
      },
      "additionalProperties": true
    },
    "stress_exemption": {
      "type": "object",
      "required": ["exempt", "reason"],
      "properties": {
        "exempt": { "const": true },
        "reason": { "type": "string", "minLength": 1 },
        "fixture_source": { "type": "string" },
        "gate_scope": { "type": "string" }
      },
      "additionalProperties": true
    },
    "scores": {
      "type": "array",
      "items": { "$ref": "#/$defs/score_entry" }
    },
    "catalog_dispositions": {
      "type": "array",
      "items": { "$ref": "#/$defs/catalog_disposition" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "score_entry": {
      "type": "object",
      "required": [
        "demo_id",
        "domain",
        "family",
        "dimension_scores",
        "gate_results",
        "passed",
        "recorded_at"
      ],
      "properties": {
        "demo_id": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "dimension_scores": {
          "type": "object",
          "required": [
            "information_architecture",
            "content_hierarchy",
            "domain_fit",
            "reader_affordances",
            "typographic_craft",
            "restraint_cohesion"
          ],
          "properties": {
            "information_architecture": { "type": "integer", "minimum": 1, "maximum": 5 },
            "content_hierarchy": { "type": "integer", "minimum": 1, "maximum": 5 },
            "domain_fit": { "type": "integer", "minimum": 1, "maximum": 5 },
            "reader_affordances": { "type": "integer", "minimum": 1, "maximum": 5 },
            "typographic_craft": { "type": "integer", "minimum": 1, "maximum": 5 },
            "restraint_cohesion": { "type": "integer", "minimum": 1, "maximum": 5 }
          },
          "additionalProperties": false
        },
        "gate_results": {
          "type": "object",
          "required": ["reading_order", "print_safety"],
          "properties": {
            "reading_order": { "type": "boolean" },
            "print_safety": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "passed": { "type": "boolean" },
        "recorded_at": { "type": "string", "format": "date" },
        "stress_exempt": { "type": "boolean" },
        "signed_off_by": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "signed_off_at": {
          "type": "string",
          "pattern": "^(?:(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)|(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))))$"
        },
        "evidence_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true,
      "if": {
        "properties": { "passed": { "const": true } },
        "required": ["passed"]
      },
      "then": {
        "required": ["signed_off_by", "signed_off_at", "evidence_ref"]
      }
    },
    "catalog_disposition": {
      "type": "object",
      "required": ["catalog_id", "family", "brand", "preset", "mode", "evidence_ref", "png_sha256", "source_pdf_sha256", "recorded_at", "review_status"],
      "properties": {
        "catalog_id": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "brand": { "type": ["string", "null"] },
        "preset": { "type": ["string", "null"] },
        "mode": { "enum": ["light", "dark"] },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "png_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_pdf_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "recorded_at": { "type": "string", "format": "date" },
        "review_status": { "enum": ["scored", "unscored"] },
        "dimension_scores": { "$ref": "#/$defs/score_entry/properties/dimension_scores" },
        "gate_results": { "$ref": "#/$defs/score_entry/properties/gate_results" },
        "passed": { "type": "boolean" },
        "signed_off_by": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "signed_off_at": {
          "type": "string",
          "pattern": "^(?:(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)|(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))))$"
        },
        "justifications": { "$ref": "#/$defs/justifications" },
        "reason": { "type": "string", "minLength": 1 },
        "supersedes_evidence_ref": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "resolution_ref": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }
      },
      "allOf": [
        {
          "if": { "properties": { "review_status": { "const": "scored" } }, "required": ["review_status"] },
          "then": { "required": ["dimension_scores", "gate_results", "passed", "signed_off_by", "signed_off_at", "justifications", "resolution_ref", "supersedes_evidence_ref"], "not": { "required": ["reason"] } }
        },
        {
          "if": { "properties": { "review_status": { "const": "unscored" } }, "required": ["review_status"] },
          "then": { "required": ["reason"], "not": { "anyOf": [{ "required": ["dimension_scores"] }, { "required": ["gate_results"] }, { "required": ["passed"] }] } }
        },
        {
          "if": { "required": ["supersedes_evidence_ref"] },
          "then": { "required": ["resolution_ref"] }
        }
      ],
      "additionalProperties": false
    },
    "justifications": {
      "type": "object",
      "required": [
        "information_architecture",
        "content_hierarchy",
        "domain_fit",
        "reader_affordances",
        "typographic_craft",
        "restraint_cohesion"
      ],
      "properties": {
        "information_architecture": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "content_hierarchy": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "domain_fit": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "reader_affordances": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "typographic_craft": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "restraint_cohesion": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }
      },
      "additionalProperties": false
    }
  }
}
