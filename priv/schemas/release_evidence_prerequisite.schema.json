{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release_evidence_prerequisite.schema.json",
  "title": "Rendro public prerequisite evidence",
  "type": "object",
  "required": ["schema_version", "role", "release", "facts", "provenance"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "role": {"const": "public_prerequisite"},
    "release": {"type": "object", "required": ["version", "tag"], "additionalProperties": false, "properties": {"version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"}}},
    "facts": {"type": "object", "required": ["version", "tag", "public_prerequisite"], "additionalProperties": true, "properties": {"version": {"type": "string"}, "tag": {"type": "string"}, "public_prerequisite": {"const": "VERIFIED"}}},
    "provenance": {"type": "object", "required": ["source_path", "import_reason", "authority_note"], "additionalProperties": false, "properties": {"source_path": {"type": "string", "minLength": 1}, "import_reason": {"type": "string", "minLength": 1}, "authority_note": {"type": "string", "minLength": 1}}}
  }
}
