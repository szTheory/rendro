{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"release_evidence_journey_index.schema.json","type":"object","required":["schema_version","role","release","candidate_commit_sha","entries","lane","provenance","import"],"additionalProperties":false,"properties":{"schema_version":{"const":1},"role":{"const":"journey_index"},"release":{"$ref":"#/$defs/release"},"candidate_commit_sha":{"$ref":"#/$defs/sha"},"entries":{"type":"array","maxItems":64,"items":{"type":"string","pattern":"^RE-[A-Z0-9-]+$"}},"lane":{"const":"advisory"},"provenance":{"$ref":"#/$defs/provenance"},"import":{"$ref":"#/$defs/import"},"supersedes":{"type":"array","maxItems":8,"items":{"type":"string","pattern":"^RE-[A-Z0-9-]+$"}}},"$defs":{"sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"release":{"type":"object","required":["version","tag","candidate_commit_sha"],"additionalProperties":false,"properties":{"version":{"const":"1.3.4"},"tag":{"const":"v1.3.4"},"candidate_commit_sha":{"$ref":"#/$defs/sha"}}},"provenance":{"type":"object","required":["source_path","source_sha256","source_commit","authority_note"],"additionalProperties":false,"properties":{"source_path":{"type":"string","minLength":1},"source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"source_commit":{"$ref":"#/$defs/sha"},"authority_note":{"const":"Git history, protected branches, and release tags remain authoritative; this capsule supplies bounded provenance and tamper evidence only."}}},"import":{"type":"object","required":["imported_at","reason","redaction_class"],"additionalProperties":false,"properties":{"imported_at":{"const":"2026-08-26"},"reason":{"type":"string","minLength":1},"redaction_class":{"const":"none"}}}}}
