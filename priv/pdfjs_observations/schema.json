{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rendro PDF.js advisory observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observer",
    "advisory_boundary",
    "pdfjs_dist_version",
    "node_version",
    "recorded_at",
    "platform",
    "fixture",
    "page_count",
    "pages",
    "warnings",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "observer": {
      "const": "rendro-pdfjs-advisory"
    },
    "advisory_boundary": {
      "type": "string",
      "minLength": 1
    },
    "pdfjs_dist_version": {
      "const": "6.0.227"
    },
    "node_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "enum": [
        "test/fixtures/embedded_artifact_support_fixture.pdf",
        "test/fixtures/pdfjs-rendro.pdf"
      ]
    },
    "page_count": {
      "type": "integer",
      "minimum": 1
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_number", "width", "height"],
        "properties": {
          "page_number": {
            "type": "integer",
            "minimum": 1
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "first_page_png_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
