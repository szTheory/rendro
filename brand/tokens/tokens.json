{
  "$meta": {
    "name": "Rendro Design Tokens",
    "version": "1.0.0",
    "source_of_truth": true,
    "generated_outputs": ["tokens.css", "tailwind.tokens.js"],
    "regenerate_with": "mix brand.gen",
    "notes": "Edit THIS file only. tokens.css and tailwind.tokens.js are generated. Semantic values use {raw-token} aliases or literal hex. Contrast ratios are computed (WCAG 2.2) and recorded in $contrast."
  },

  "brand": {
    "name": "Rendro",
    "tagline": "Native PDF layout for Elixir.",
    "mantra": "Render the document. Respect the system. Explain the failure.",
    "personality": ["precise", "calm", "helpful", "native", "observable", "crafted", "open"]
  },

  "raw": {
    "ink-900": "#101827",
    "ink-700": "#1F2937",
    "ink-500": "#5B6573",
    "paper-100": "#F7F3EA",
    "paper-200": "#EFE8DA",
    "sheet-000": "#FFFFFF",
    "line-300": "#D8D2C3",
    "line-400": "#C4BCA9",
    "blue-700": "#1F4FB8",
    "blue-600": "#2C6BED",
    "blue-300": "#7FA9FF",
    "blue-200": "#A6C4FF",
    "blue-100": "#D9E8FF",
    "teal-700": "#0E7C76",
    "plum-700": "#6E3CB8",
    "plum-100": "#E9DDFB",
    "amber-600": "#C78600",
    "amber-300": "#E6B450",
    "red-700": "#C24132",
    "red-300": "#E0715F",
    "green-700": "#147A4B",
    "green-300": "#3FB37F",
    "mint-100": "#DDF4EE",
    "sand-200": "#EDE4D3",
    "night-900": "#14110D",
    "night-800": "#1B1713",
    "night-700": "#232019",
    "night-600": "#2C2820",
    "night-500": "#3A352B",
    "night-400": "#4A4439",
    "paper-d-50": "#F2ECE0",
    "paper-d-200": "#CDC6B8",
    "paper-d-400": "#968F7E"
  },

  "semantic": {
    "light": {
      "text-primary": "{ink-900}",
      "text-secondary": "{ink-700}",
      "text-muted": "{ink-500}",
      "text-inverse": "{sheet-000}",
      "text-link": "{blue-700}",
      "text-link-hover": "{blue-600}",
      "bg-page": "{paper-100}",
      "bg-surface": "{sheet-000}",
      "bg-raised": "{paper-200}",
      "bg-code": "{sand-200}",
      "border-default": "{line-300}",
      "border-strong": "{line-400}",
      "border-subtle": "{paper-200}",
      "accent": "{blue-600}",
      "accent-strong": "{blue-700}",
      "focus-ring": "{blue-600}",
      "selection-bg": "{blue-100}",
      "feedback-info": "{blue-600}",
      "feedback-info-bg": "{blue-100}",
      "feedback-success": "{green-700}",
      "feedback-success-bg": "{mint-100}",
      "feedback-warning": "{amber-600}",
      "feedback-warning-bg": "{sand-200}",
      "feedback-error": "{red-700}",
      "feedback-error-bg": "{sheet-000}",
      "action-primary-bg": "{blue-600}",
      "action-primary-bg-hover": "{blue-700}",
      "action-primary-text": "{sheet-000}"
    },
    "dark": {
      "text-primary": "{paper-d-50}",
      "text-secondary": "{paper-d-200}",
      "text-muted": "{paper-d-400}",
      "text-inverse": "{ink-900}",
      "text-link": "{blue-300}",
      "text-link-hover": "{blue-200}",
      "bg-page": "{night-800}",
      "bg-surface": "{night-700}",
      "bg-raised": "{night-600}",
      "bg-code": "{night-900}",
      "border-default": "{night-500}",
      "border-strong": "{night-400}",
      "border-subtle": "{night-600}",
      "accent": "{blue-300}",
      "accent-strong": "{blue-200}",
      "focus-ring": "{blue-300}",
      "selection-bg": "#2A3550",
      "feedback-info": "{blue-300}",
      "feedback-info-bg": "#1B2A4A",
      "feedback-success": "{green-300}",
      "feedback-success-bg": "#13241B",
      "feedback-warning": "{amber-300}",
      "feedback-warning-bg": "#2A2113",
      "feedback-error": "{red-300}",
      "feedback-error-bg": "#2A1714",
      "action-primary-bg": "{blue-600}",
      "action-primary-bg-hover": "{blue-300}",
      "action-primary-text": "{sheet-000}"
    }
  },

  "type": {
    "family": {
      "sans": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace",
      "fallback": "'Noto Sans', sans-serif"
    },
    "scale": {
      "display-xl": { "size": "56px", "line": "64px", "weight": 700 },
      "display-l":  { "size": "44px", "line": "52px", "weight": 700 },
      "h1":         { "size": "36px", "line": "44px", "weight": 700 },
      "h2":         { "size": "28px", "line": "36px", "weight": 600 },
      "h3":         { "size": "22px", "line": "30px", "weight": 600 },
      "body-l":     { "size": "18px", "line": "30px", "weight": 400 },
      "body":       { "size": "16px", "line": "26px", "weight": 400 },
      "body-s":     { "size": "14px", "line": "22px", "weight": 400 },
      "caption":    { "size": "12px", "line": "18px", "weight": 500 },
      "code":       { "size": "14px", "line": "22px", "weight": 400 },
      "code-s":     { "size": "12px", "line": "18px", "weight": 400 }
    }
  },

  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px",
    "24": "96px"
  },

  "radius": {
    "control": "6px",
    "code": "10px",
    "card": "12px",
    "panel": "16px",
    "document": "4px",
    "pill": "999px"
  },

  "border": {
    "width-1": "1px",
    "width-2": "2px"
  },

  "shadow": {
    "card": "0 1px 2px rgba(16,24,39,0.06), 0 2px 8px rgba(16,24,39,0.06)",
    "sheet": "0 1px 2px rgba(16,24,39,0.08), 0 10px 28px rgba(16,24,39,0.12)"
  },

  "motion": {
    "micro": "140ms",
    "panel": "220ms",
    "diagram": "900ms",
    "easing": "cubic-bezier(0.2, 0.0, 0.0, 1.0)",
    "reduced_motion": "Respect prefers-reduced-motion: reduce — disable diagram/panel transitions, keep instant state changes."
  },

  "state": {
    "disabled-opacity": "0.45",
    "focus-ring-width": "2px",
    "focus-ring-offset": "2px"
  },

  "grid": {
    "marketing-max": "1120px",
    "docs-max": "880px",
    "guide-max": "1040px",
    "app-max": "1280px"
  },

  "$contrast": {
    "note": "Computed WCAG 2.2 contrast ratios. AA = 4.5:1 normal text, 3:1 large text / non-text graphics.",
    "light": {
      "ink-900 on paper-100": { "ratio": 16.08, "passes": "AAA" },
      "ink-900 on sheet-000": { "ratio": 17.81, "passes": "AAA" },
      "ink-700 on paper-100": { "ratio": 13.9, "passes": "AAA" },
      "ink-500 on paper-100": { "ratio": 4.9, "passes": "AA normal" },
      "blue-700 on paper-100 (body links)": { "ratio": 6.6, "passes": "AA normal" },
      "blue-600 on sheet-000": { "ratio": 4.74, "passes": "AA normal (borderline)" },
      "blue-600 on paper-100": { "ratio": 4.28, "passes": "AA large only — do NOT use for small body text" },
      "teal-700 on sheet-000": { "ratio": 5.05, "passes": "AA normal" },
      "plum-700 on sheet-000": { "ratio": 7.0, "passes": "AAA" },
      "red-700 on sheet-000": { "ratio": 5.13, "passes": "AA normal" },
      "green-700 on sheet-000": { "ratio": 5.37, "passes": "AA normal" },
      "amber-600 on sheet-000": { "ratio": 3.07, "passes": "AA large / graphics only — never body text; use as bg/border with ink text" }
    },
    "dark": {
      "paper-d-50 on night-800": { "ratio": 15.15, "passes": "AAA" },
      "paper-d-200 on night-800": { "ratio": 10.1, "passes": "AAA" },
      "paper-d-400 on night-800": { "ratio": 4.7, "passes": "AA normal" },
      "blue-300 on night-800 (links)": { "ratio": 7.65, "passes": "AAA" },
      "green-300 on night-800": { "ratio": 8.0, "passes": "AAA" },
      "red-300 on night-800": { "ratio": 5.9, "passes": "AA normal" },
      "amber-300 on night-800": { "ratio": 9.1, "passes": "AAA" }
    }
  }
}
